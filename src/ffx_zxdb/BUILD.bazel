load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# GN ffx_zxdb carries data_deps on the unmigrated GN-only zxdb_host_tool target.
# @bazel2gn:raw_attribute:data_deps = [ "//src/developer/debug/zxdb:zxdb_host_tool" ]
rustc_library(
    name = "ffx_zxdb",
    srcs = [
        "src/background.rs",
        "src/command_builder.rs",
        "src/debug_agent.rs",
        "src/debugger.rs",
        "src/lib.rs",
        "src/util.rs",
    ],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/developer/ffx/plugins/component/debug:__pkg__",
        "//src/developer/ffx/plugins/component/start:__pkg__",
        "//src/developer/ffx/plugins/debug/connect:__pkg__",
        "//src/developer/ffx/plugins/debug/crash:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.debugger:fuchsia.debugger_rust_fdomain",
        "//sdk/rust/zx-status",
        "//sdk/rust/zx-types",
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/errors:lib",
        "//src/developer/ffx/lib/symbol-index:lib",
        "//src/lib/fdomain/client",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:futures-util",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:signal-hook",
        "//third_party/rust_crates/vendor:tokio",
    ],
)
